rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'tebyan@app.com';
    }

    function profile() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid));
    }

    function isLecturer() {
      return hasProfile() && profile().type in ['Lecturere', 'Lecturer'];
    }

    // The lecturer is assigned to this course
    function teaches(courseId) {
      return isLecturer() && courseId in profile().courses;
    }

    // The student is registered in this course
    function enrolled(courseId) {
      return hasProfile() && profile().type == 'Student' &&
        courseId in profile().courses;
    }

    function session(courseId, lectureId) {
      return get(/databases/$(database)/documents/Courses/$(courseId)/Lectures/$(lectureId)/Session/current).data;
    }

    // The code changes every 20 seconds on the lecturer's screen.
    // Accept the current code (while the lecturer's screen is still open)
    // or the previous one for 30 more seconds.
    function codeIsFresh(s) {
      return (request.resource.data.token == s.token &&
                request.time < s.tokenAt + duration.value(90, 's')) ||
             (s.prevToken != '' && request.resource.data.token == s.prevToken &&
                request.time < s.tokenAt + duration.value(30, 's'));
    }

    // When the lecturer turned on the location check, the student must be
    // inside the allowed distance (same formula as the app).
    function distanceSquared(s) {
      let dy = (request.resource.data.lat - s.lat) * 110574;
      let dx = (request.resource.data.lng - s.lng) * s.lngScale;
      return dx * dx + dy * dy;
    }

    function insideClassroom(s) {
      return s.get('radius', 0) == 0 || (
        request.resource.data.get('lat', null) is number &&
        request.resource.data.get('lng', null) is number &&
        distanceSquared(s) <= (s.radius + s.tolerance) * (s.radius + s.tolerance)
      );
    }

    function canCheckIn(courseId, lectureId) {
      let s = session(courseId, lectureId);
      return request.time < s.expiresAt && codeIsFresh(s) && insideClassroom(s);
    }

    // ---------- users ----------
    match /Users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid) || isLecturer();
      allow write: if isAdmin();
    }

    // ---------- courses ----------
    match /Courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /Lectures/{lectureId} {
        allow read: if signedIn();
        allow write: if isAdmin() || teaches(courseId);

        // Secret attendance code: only the lecturer can see it
        match /Session/{doc} {
          allow read, write: if isAdmin() || teaches(courseId);
        }

        match /Attendance/{studentId} {
          allow read: if isAdmin() || teaches(courseId) ||
            (signedIn() && request.auth.uid == studentId);

          // Lecturer can mark manually. A student can only record their own
          // attendance, with the code shown right now, before attendance
          // closes, and from inside the classroom (when required).
          allow create: if isAdmin() || teaches(courseId) || (
            signedIn() && request.auth.uid == studentId &&
            enrolled(courseId) &&
            request.resource.data.studentId == studentId &&
            canCheckIn(courseId, lectureId)
          );

          allow update, delete: if isAdmin() || teaches(courseId);
        }
      }
    }
  }
}
